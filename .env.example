# Supabase account/auth configuration
# Public browser-safe project URL and publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Prefer a current sb_secret_... key.
# A legacy service_role JWT is also supported through SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only 32-byte AES key, base64 or 64-character hex.
# Generate once and keep unchanged while stored Plex/Trakt connections exist:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# Trakt device authorization and watched-history synchronization
# Paste raw values without quotes or trailing spaces. Redeploy after changes.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Optional richer artwork discovery for shows, seasons, episodes and events.
# Use a TMDB API Read Access Token (Bearer token), not a browser API key.
TMDB_READ_ACCESS_TOKEN=
